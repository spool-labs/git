# Build against a local checkout of the tape monorepo instead of crates.io.
#
#   cp .cargo/config.toml.example .cargo/config.toml
#
# Cargo.toml asks for the Tapedrive crates by version, the way any published
# dependency is declared. This file redirects those requests to a sibling checkout,
# so the same Cargo.toml works whether you are developing against local sources or
# building from the registry. Nothing in `src/` or `Cargo.toml` changes either way.
#
# A patch resolves before the registry is consulted, so this also works for crates
# that are not published yet: Cargo reads the version out of each local
# `Cargo.toml` and never asks the index. The version requirements in Cargo.toml
# still have to be satisfiable by what is on disk, so if the monorepo's
# `[workspace.package] version` moves past 0.4, bump them together.
#
# Paths are relative to the crate root. The default below assumes:
#
#   <somewhere>/tapedrive/git/       <- you are here
#   <somewhere>/tapedrive/runtime/   <- the runtime monorepo
#
# Adjust if your checkouts sit elsewhere. `.cargo/config.toml` itself is
# gitignored, so your local paths never end up in a commit.

[net]
git-fetch-with-cli = true

[patch.crates-io]
tape-sdk = { path = "../runtime/sdk" }
tape-api = { path = "../runtime/solana/api" }
tape-core = { path = "../runtime/lib/core" }
tape-crypto = { path = "../runtime/lib/crypto" }
tape-protocol = { path = "../runtime/network/protocol" }
rpc-solana = { path = "../runtime/solana/rpc-solana" }
peer-http = { path = "../runtime/network/peer-http" }
